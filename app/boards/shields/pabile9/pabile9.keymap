#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			// ----------------------
			// |  O   |  O   |  O   |
			// ----------------------
			// |  7   |  8   |  9   |
			// |  4   |  5   |  6   |
			// |  1   |  2   |  3   |

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;

			bindings = <
				&kp KP_N7     &kp KP_N8    &kp KP_N9
				&lt 4 KP_N4   &kp KP_N5    &kp KP_N6
				&lt 1 KP_N1   &lt 2 KP_N2  &lt 3 KP_N3
			>;
		};
		1 {
			bindings = <
                &kp PAGE_UP &kp UP    &kp PAGE_DOWN
                &kp LEFT    &kp DOWN  &kp RIGHT
                &trans      &trans    &trans
			>;
		};
		2 {
			bindings = <
                &mkp LCLK      &mmv MOVE_UP   &mkp RCLK
                &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT
                &trans         &trans         &trans
			>;
		};
		3 {
			bindings = <
                &trans   &trans    &trans
                &trans   &trans    &trans
                &kp KP_ENTER   &kp KP_DOT    &trans
			>;
		};
		4 {
			bindings = <
				&rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &ext_power EP_TOG
				&trans           &bt BT_CLR       &bt BT_NXT
				&out OUT_TOG     &studio_unlock   &bootloader
			>;
		};
	};
};

